# ---------------------------------------------------------------------------
# Backend environment example — COPY to .env and fill in real values.
# The real .env is git-ignored. Never commit secrets (requirements.md C-06).
# Values below are placeholders / safe development defaults.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# Comma-separated list of browser origins allowed for CORS.
# Use the Vite dev server origin for local development. Leave empty to
# disable cross-origin access (same-origin only).
CORS_ORIGINS=http://localhost:5173

# Max JSON request body size (bytes with unit suffix: kb/mb)
JSON_BODY_LIMIT=100kb

# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL (Phase 3) ----------------------------------------------------
# Connection string for the development database.
# Matches docker-compose.yml "db" service defaults (b2b user / b2b_oms db).
# Host port 5433 (compose maps it there so a native PostgreSQL on 5432 can't
# hijack the connection). Create it safely with:
#   npm run db:create && npm run db:migrate && npm run db:seed
DATABASE_URL=postgres://b2b:change-me-dev-only@localhost:5433/b2b_oms
# Separate database used ONLY by the integration test suite, so tests never
# touch development data. Create it safely with: npm run db:create:test
DATABASE_URL_TEST=postgres://b2b:change-me-dev-only@localhost:5433/b2b_oms_test
# Connection pool size / per-connection acquire timeout (optional)
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000

# --- Authentication (Phase 4) ------------------------------------------------
# Secrets MUST come from the environment (C-06). Generate long random values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the app REFUSES TO START if these are missing/short/dev-default.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-refresh
# Short-lived bearer token / rotating refresh cookie (jsonwebtoken notation)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Verified on every token (iss / aud claims)
JWT_ISSUER=b2b-oms
JWT_AUDIENCE=b2b-oms-api
# bcrypt cost factor (12 ≈ ~250ms/hash — comfortable for auth endpoints)
BCRYPT_ROUNDS=12
# Set true when serving over HTTPS so auth cookies get the Secure flag.
# Production REQUIRES this to be true.
COOKIE_SECURE=false
# Auth rate limiting (per client IP, fixed window). Defaults shown.
# AUTH_RATE_WINDOW_MS=900000
# AUTH_RATE_MAX=10
# REGISTER_RATE_MAX=5

# --- Products & Inventory (Phase 5) ----------------------------------------
# No new environment variables. The catalog default page size (limit=20) and the
# low-stock rule (inventory.low_stock_threshold, NOT NULL DEFAULT 20; a product is
# low-stock iff available_quantity <= low_stock_threshold) live in code/schema, not
# env — see docs/api-specification.md §2.2 and decision D-20.
