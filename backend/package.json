{
  "name": "b2b-oms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "B2B Order Management Platform — Express API (Phase 4: authentication & RBAC)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec",
    "test:integration": "node scripts/db/run-integration-tests.js",
    "test:coverage": "node scripts/db/run-coverage.js",
    "lint": "eslint .",
    "db:create": "node scripts/db/create-db.js",
    "db:create:test": "node scripts/db/create-db.js --test",
    "db:migrate": "node scripts/db/migrate.js up",
    "db:migrate:test": "node scripts/db/migrate.js up --test",
    "db:migrate:down": "node scripts/db/migrate.js down",
    "db:migrate:down:test": "node scripts/db/migrate.js down --test",
    "db:seed": "node scripts/db/seed.js",
    "db:bootstrap:e2e": "node scripts/db/bootstrap-e2e.js",
    "db:health": "node scripts/db/health-check.js",
    "db:health:test": "node scripts/db/health-check.js --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "supertest": "^7.1.0"
  }
}
