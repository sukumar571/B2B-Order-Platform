# ---------------------------------------------------------------------------
# ROOT environment example for Docker Compose — COPY to `.env` (git-ignored)
# before the first `docker compose up`. Compose reads `.env` from this
# directory automatically; `--env-file` can point elsewhere.
#
#   cp .env.example .env     # then edit
#
# .env holds REAL secrets and must never be committed or copied into an image:
# no Dockerfile COPYs it, and every .dockerignore excludes it.
# The service-level templates (backend/.env.example, frontend/.env.example)
# cover host-side development without Docker.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=b2b
# REQUIRED — Compose refuses to start without it (no hardcoded fallback).
# The value below is a local-dev placeholder: replace it for any shared host.
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=b2b_oms

# --- Authentication secrets -------------------------------------------------
# REQUIRED. Compose fails fast if these are unset, and the API additionally
# refuses to boot under NODE_ENV=production when they are shorter than 32
# characters or still the dev default (backend/src/config/env.js).
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-at-least-32

# Set the cookie `Secure` flag. MUST stay true in production (HTTPS-only auth
# cookies). Browsers still accept Secure cookies on http://localhost, so the
# local demo works; any other host needs real TLS.
COOKIE_SECURE=true

# --- Ports published to the host -------------------------------------------
# Public browser origin for the SPA (nginx). Everything else reaches the API
# same-origin through nginx's /api proxy.
WEB_PORT=8080

# Dev-override only (docker-compose.dev.yml): host ports for host-side npm
# scripts, the Vite dev server and the test suites.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=4000

# --- Optional ---------------------------------------------------------------
# Comma-separated browser origins allowed for CORS. Leave EMPTY when the SPA
# and API share one origin through nginx (the Compose default).
CORS_ORIGINS=

# Image tag suffix, so `up` can pin a release build: local | 1.0.0 | git-sha
B2B_IMAGE_TAG=local
