# ---------------------------------------------------------------------------
# Frontend environment example — COPY to .env for local overrides.
# The real .env is git-ignored. Vite only exposes variables prefixed VITE_.
# ---------------------------------------------------------------------------

# Absolute API origin. Leave EMPTY for local dev (Vite proxies /api to the
# backend). Set when the SPA and API are served from different hosts,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api requests (backend origin).
# Must match the backend PORT (default 4000).
VITE_BACKEND_ORIGIN=http://localhost:4000
